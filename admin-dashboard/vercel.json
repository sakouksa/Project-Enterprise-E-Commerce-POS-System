{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/storage/:path*",
      "destination": "https://enterprise-pos-api.onrender.com/api/v1/storage/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://enterprise-pos-api.onrender.com/api/v1/storage/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
